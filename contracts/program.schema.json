{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexos:engineering-program:0.1.0",
  "title": "NexOS engineering program metadata and inactive handoff templates",
  "description": "Structural engineering metadata and handoff checks only. References, graph closure, scope coverage, external authority and observed state require semantic verification. Templates never authorize work; completed records do not acquire leases or renew grants.",
  "oneOf": [
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/state"
    },
    {
      "$ref": "#/$defs/matrix"
    },
    {
      "$ref": "#/$defs/mandate_template"
    },
    {
      "$ref": "#/$defs/checkpoint_template"
    },
    {
      "$ref": "#/$defs/mandate"
    },
    {
      "$ref": "#/$defs/checkpoint"
    }
  ],
  "$defs": {
    "version": {
      "const": "0.1.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}$"
    },
    "experience_id": {
      "type": "string",
      "pattern": "^E[0-9]{2}$"
    },
    "invariant_id": {
      "type": "string",
      "pattern": "^I[0-9]{2}$"
    },
    "milestone_id": {
      "type": "string",
      "pattern": "^M[0-9]{1,3}$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "short_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "json_record_path": {
      "allOf": [
        {
          "$ref": "#/$defs/relative_path"
        },
        {
          "pattern": "\\.json$"
        }
      ]
    },
    "checkpoint_record_path": {
      "allOf": [
        {
          "$ref": "#/$defs/json_record_path"
        },
        {
          "not": {
            "const": "program/checkpoint-template.json"
          }
        }
      ]
    },
    "status": {
      "enum": [
        "pending",
        "in_progress",
        "implemented",
        "qualified",
        "blocked"
      ]
    },
    "package": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/package_id"
        },
        "title": {
          "$ref": "#/$defs/short_text"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package_id"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "experiences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/experience_id"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invariant_id"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "milestone": {
          "$ref": "#/$defs/milestone_id"
        },
        "document": {
          "$ref": "#/$defs/relative_path"
        },
        "qualification_kind": {
          "enum": [
            "specification",
            "engineering",
            "runtime"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "depends_on",
        "experiences",
        "invariants",
        "milestone",
        "document",
        "qualification_kind"
      ],
      "additionalProperties": false
    },
    "milestone": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/milestone_id"
        },
        "title": {
          "$ref": "#/$defs/short_text"
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package_id"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "claim": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "title",
        "requires",
        "claim"
      ],
      "additionalProperties": false
    },
    "release_profile": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/profile_id"
        },
        "title": {
          "$ref": "#/$defs/short_text"
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package_id"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "qualifier_package": {
          "$ref": "#/$defs/package_id"
        },
        "experiences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/experience_id"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invariant_id"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "claim": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "title",
        "requires",
        "qualifier_package",
        "experiences",
        "invariants",
        "claim"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/version"
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "milestones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/milestone"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "release_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/release_profile"
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "schema_version",
        "packages",
        "milestones",
        "release_profiles"
      ],
      "additionalProperties": false
    },
    "blocker": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/short_text"
        },
        "type": {
          "enum": [
            "authority",
            "access",
            "resource",
            "contract",
            "dependency",
            "defect"
          ]
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "affected_acceptance_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/short_text"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relative_path"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "resolution_needed": {
          "$ref": "#/$defs/text"
        },
        "prior_status": {
          "enum": [
            "pending",
            "in_progress",
            "implemented",
            "qualified"
          ]
        },
        "independent_packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package_id"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "id",
        "type",
        "summary",
        "affected_acceptance_ids",
        "evidence_refs",
        "resolution_needed",
        "prior_status",
        "independent_packages",
        "recorded_at"
      ],
      "additionalProperties": false
    },
    "lease": {
      "type": "object",
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/short_text"
        },
        "holder": {
          "$ref": "#/$defs/short_text"
        },
        "coordinator_ref": {
          "$ref": "#/$defs/short_text"
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package_id"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relative_path"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "fencing_token": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "claim_id",
        "holder",
        "coordinator_ref",
        "packages",
        "paths",
        "issued_at",
        "expires_at",
        "fencing_token"
      ],
      "additionalProperties": false
    },
    "package_state": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "lease": {
          "anyOf": [
            {
              "$ref": "#/$defs/lease"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/checkpoint_record_path"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json_record_path"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "lease",
        "checkpoint",
        "evidence",
        "blockers"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "qualified"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            }
          },
          "then": {
            "properties": {
              "blockers": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "profile_state": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json_record_path"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "evidence",
        "blockers"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "qualified"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            }
          },
          "then": {
            "properties": {
              "blockers": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/version"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "packages": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 256,
          "patternProperties": {
            "^P[0-9]{2}$": {
              "$ref": "#/$defs/package_state"
            }
          },
          "additionalProperties": false
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,63}$": {
              "$ref": "#/$defs/profile_state"
            }
          },
          "additionalProperties": false
        },
        "qualification": {
          "enum": [
            "not_started",
            "in_progress",
            "partial"
          ]
        }
      },
      "required": [
        "schema_version",
        "revision",
        "packages",
        "profiles",
        "qualification"
      ],
      "additionalProperties": false
    },
    "matrix_invariant": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/invariant_id"
        },
        "title": {
          "$ref": "#/$defs/short_text"
        },
        "normative_ref": {
          "$ref": "#/$defs/relative_path"
        },
        "experiences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/experience_id"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package_id"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "title",
        "normative_ref",
        "experiences",
        "packages"
      ],
      "additionalProperties": false
    },
    "matrix_experience": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/experience_id"
        },
        "title": {
          "$ref": "#/$defs/short_text"
        },
        "document": {
          "$ref": "#/$defs/relative_path"
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package_id"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invariant_id"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "qualification": {
          "const": "not_implemented"
        }
      },
      "required": [
        "id",
        "title",
        "document",
        "packages",
        "invariants",
        "qualification"
      ],
      "additionalProperties": false
    },
    "matrix": {
      "type": "object",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/version"
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/matrix_invariant"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "experiences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/matrix_experience"
          },
          "minItems": 1,
          "maxItems": 128
        }
      },
      "required": [
        "schema_version",
        "invariants",
        "experiences"
      ],
      "additionalProperties": false
    },
    "scope_template": {
      "type": "object",
      "properties": {
        "package_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package_id"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "milestone_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/milestone_id"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "release_profile_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile_id"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "package_ids",
        "milestone_ids",
        "release_profile_ids"
      ],
      "additionalProperties": false
    },
    "monetary_limit_template": {
      "type": "object",
      "properties": {
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "minor_unit_exponent": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            {
              "type": "null"
            }
          ]
        },
        "amount_minor": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "currency",
        "minor_unit_exponent",
        "amount_minor"
      ],
      "additionalProperties": false
    },
    "resource_limits_template": {
      "type": "object",
      "properties": {
        "deadline_utc": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "wall_clock_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 31536000
            },
            {
              "type": "null"
            }
          ]
        },
        "token_limit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "monetary_limit": {
          "$ref": "#/$defs/monetary_limit_template"
        }
      },
      "required": [
        "deadline_utc",
        "wall_clock_seconds",
        "token_limit",
        "monetary_limit"
      ],
      "additionalProperties": false
    },
    "authorized_action": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "local_read",
            "local_edit",
            "local_test",
            "repository_read",
            "repository_write",
            "external_compute",
            "publish",
            "deploy",
            "physical_actuation"
          ]
        },
        "target_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/short_text"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "authority_ref": {
          "$ref": "#/$defs/short_text"
        },
        "expires_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation",
        "target_scope",
        "authority_ref",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "mandate_template": {
      "type": "object",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/version"
        },
        "kind": {
          "const": "engineering_mandate_template"
        },
        "template": {
          "const": true
        },
        "active": {
          "const": false
        },
        "mandate_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/short_text"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/short_text"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope_template"
        },
        "repository_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "base_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/commit"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_environment_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/short_text"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowed_roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/short_text"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "inherited_authorization_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/short_text"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "authorized_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authorized_action"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "resource_limits": {
          "$ref": "#/$defs/resource_limits_template"
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "enum": [
              "assigned_scope_qualified",
              "user_interrupt",
              "resource_limit",
              "mandate_expired",
              "all_authorized_paths_blocked"
            ]
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "kind",
        "template",
        "active",
        "mandate_id",
        "owner",
        "scope",
        "repository_url",
        "base_revision",
        "target_environment_profile",
        "allowed_roots",
        "inherited_authorization_refs",
        "authorized_actions",
        "resource_limits",
        "stop_conditions",
        "notes"
